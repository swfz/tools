{
  "name": "tools",
  "private": true,
  "version": "1.0.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:format": "prettier --check './**/*.{js,ts,tsx,json,css}'",
    "format": "prettier --write './**/*.{js,ts,tsx,json,css}'",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "test": "jest --watch",
    "test:ci": "jest --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@primer/octicons-react": "19.40.0",
    "@tailwindcss/forms": "0.5.11",
    "@tanstack/react-query": "^5.0.0",
    "@vercel/og": "1.0.3",
    "dayjs": "1.11.23",
    "next": "16.4.1",
    "next-pwa": "5.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use": "17.6.1",
    "sharp": "0.35.5",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-actions": "9.0.8",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-postcss": "2.0.0",
    "@storybook/builder-webpack5": "10.6.2",
    "@storybook/manager-webpack5": "6.5.16",
    "@storybook/react": "10.6.2",
    "@storybook/testing-library": "0.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/gtag.js": "0.0.20",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/parser": "8.71.1",
    "autoprefixer": "10.6.1",
    "babel-loader": "10.1.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "espree": "11.2.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.14.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,css,md}": "prettier --check"
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120
